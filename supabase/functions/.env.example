# Edge Function secrets. Local: copy to supabase/functions/.env.
# Hosted: npx supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.

# Comma-separated list of allowed web origins (CORS + OAuth redirect allowlist)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Content providers (all optional; keyless fallbacks cover books, podcasts, music previews, TV) ──
YOUTUBE_API_KEY=
TMDB_READ_TOKEN=
TMDB_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US
# Override only if your OAuth redirect differs from <SUPABASE_URL>/functions/v1/spotify
SPOTIFY_REDIRECT_URI=

# ── Optional AI inference (any OpenAI-compatible endpoint; ECHO works without it) ──
# Groq:        AI_BASE_URL=https://api.groq.com/openai/v1         AI_MODEL=llama-3.1-8b-instant
# OpenRouter:  AI_BASE_URL=https://openrouter.ai/api/v1           AI_MODEL=<a :free model>
# Gemini:      AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=gemini-2.0-flash
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Semantic embeddings with Supabase's built-in gte-small model (free; uses Edge Function CPU time)
ECHO_EMBEDDINGS=off
# Minimum number of active users before collaborative filtering switches on
ECHO_CF_MIN_USERS=20
# Only needed if your project has legacy JWT keys disabled (new sb_secret_… key)
ECHO_SERVICE_KEY=
