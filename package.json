{
  "name": "echo",
  "private": true,
  "version": "0.1.0",
  "description": "ECHO — Discover beyond the algorithm. A personal cross-media discovery agent.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:functions": "deno check --config supabase/functions/deno.json supabase/functions/*/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "test:db": "bash scripts/test-db.sh",
    "sb:start": "supabase start",
    "sb:functions": "supabase functions serve --env-file supabase/functions/.env",
    "sb:deploy": "bash scripts/deploy-supabase.sh"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "deno": "^2.9.6",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "supabase": "^3.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
