# Frontend (Vite) — copy to .env.local. These values are PUBLIC by design:
# the publishable key only works through row-level security.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Optional: override the Edge Functions base URL (defaults to <VITE_SUPABASE_URL>/functions/v1)
# VITE_FUNCTIONS_URL=http://127.0.0.1:54331/functions/v1

# Never put server secrets (sb_secret_…, provider API keys) in VITE_ variables.
# Server secrets go in supabase/functions/.env (see supabase/functions/.env.example).
